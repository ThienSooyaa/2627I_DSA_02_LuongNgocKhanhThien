def insertion_sort(l):
    for i in range(1, len(l)):
        j = i - 1
        key = l[i]
        while (j >= 0) and (l[j] > key):#lúc chưa sửa bị thiếu dấu bằng ==> các phần tử nhỏ hơn l[0] sẽ ko bao h đc chèn vào đúng vị trí của nó
            l[j + 1] = l[j]
            j -= 1
        l[j + 1] = key  

m = int(input().strip())
ar = [int(i) for i in input().strip().split()]
insertion_sort(ar)
